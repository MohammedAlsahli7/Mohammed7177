# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=8080

# Required in production: long random string that signs staff sessions.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BARA_SECRET=

# First admin account — created on first start only (when there are no accounts yet).
BARA_ADMIN_USER=admin
BARA_ADMIN_PASSWORD=

# Where the database and uploaded files live (Docker: /data volume).
BARA_DATA_DIR=./var

# Behind a reverse proxy / load balancer that sets X-Forwarded-For (for per-IP rate limits).
BARA_TRUST_PROXY=false
# Force the Secure cookie flag (auto-detected from X-Forwarded-Proto=https otherwise).
# BARA_COOKIE_SECURE=true

# Only if the website is hosted elsewhere (e.g. Netlify) and posts forms to this server:
# BARA_ALLOWED_ORIGINS=https://bara.sa,https://www.bara.sa

# How often to poll OctoPrint / Moonraker printers (ms) and max upload size (MB).
BARA_PRINTER_POLL_MS=5000
BARA_MAX_UPLOAD_MB=100
