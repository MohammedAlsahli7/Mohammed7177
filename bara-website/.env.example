# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=8080

# Required in production: long random string that signs staff sessions.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BARA_SECRET=

# First admin account — created on first start only (when there are no accounts yet).
BARA_ADMIN_USER=admin
BARA_ADMIN_PASSWORD=

# Where the database and uploaded files live (Docker: /data volume).
BARA_DATA_DIR=./var

# Behind a reverse proxy / load balancer that sets X-Forwarded-For (for per-IP rate limits).
BARA_TRUST_PROXY=false
# Force the Secure cookie flag (auto-detected from X-Forwarded-Proto=https otherwise).
# BARA_COOKIE_SECURE=true

# ---- Online payment (checkout) ----
# moyasar | tap | stripe. Empty = checkout off (the cart offers "order by email").
BARA_PAY_PROVIDER=
# The provider's SECRET key (sk_live_… / sk_test_…). Never the publishable key.
BARA_PAY_SECRET_KEY=
# Optional extra check on webhooks: Moyasar "secret token" or Stripe "whsec_…".
BARA_PAY_WEBHOOK_SECRET=
# Your site's public address, used for the payment page's return links.
BARA_PUBLIC_URL=https://your-domain.sa
# Apple Pay on your own domain: path to Apple's domain-association file
# (default: <BARA_DATA_DIR>/apple-developer-merchantid-domain-association).
# BARA_APPLE_PAY_DOMAIN_FILE=

# Paid-order webhook: your payment provider / store system posts paid orders to
# POST /api/orders with  Authorization: Bearer <this token>. Long random string.
BARA_ORDER_TOKEN=

# Only if the website is hosted elsewhere (e.g. Netlify) and posts forms to this server:
# BARA_ALLOWED_ORIGINS=https://bara.sa,https://www.bara.sa

# How often to poll OctoPrint / Moonraker printers (ms) and max upload size (MB).
BARA_PRINTER_POLL_MS=5000
BARA_MAX_UPLOAD_MB=100
